
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>STYVIO IA</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101522;
      color: white;
      display: flex;
      flex-direction: column;
      height: 100dvh;
    }
    header {
      padding: 18px;
      background: #19243a;
      text-align: center;
      font-size: 23px;
      font-weight: bold;
    }
    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
    }
    .msg {
      margin: 10px 0;
      padding: 12px;
      border-radius: 12px;
      background: #253149;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .user { background: #245caa; }
    form {
      display: flex;
      gap: 8px;
      padding: 12px;
      background: #19243a;
    }
    input {
      flex: 1;
      min-width: 0;
      padding: 13px;
      border-radius: 10px;
      border: 0;
    }
    button {
      padding: 12px;
      border: 0;
      border-radius: 10px;
      background: #4385f5;
      color: white;
    }
    button:disabled { opacity: 0.6; }
  </style>
</head>
<body>
  <header>STYVIO IA</header>

  <div id="chat" aria-live="polite">
    <div class="msg">Salama! Izaho no STYVIO IA. Inona no azoko anampiana anao?</div>
  </div>

  <form id="form">
    <input id="question" placeholder="Soraty eto ny hafatra..." required>
    <button id="send" type="submit">Alefa</button>
  </form>

  <script>
    const form = document.getElementById('form');
    const chat = document.getElementById('chat');
    const question = document.getElementById('question');
    const send = document.getElementById('send');

    const API_URL = 'https://styvio-ia-server.onrender.com/chat';

    function addMessage(text, isUser = false) {
      const div = document.createElement('div');
      div.className = isUser ? 'msg user' : 'msg';
      div.textContent = text;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const message = question.value.trim();
      if (!message) return;

      addMessage(message, true);
      question.value = '';
      question.disabled = true;
      send.disabled = true;

      const reply = addMessage('Miandry valiny...');
      
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ question: message })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Nisy olana tamin’ny serveur.');
        }

        reply.textContent = data.answer || 'Tsy nahazo valiny ny IA.';
      } catch (error) {
        reply.textContent =
          'Tsy afaka nahazo valiny. Jereo ny connexion Internet na ny serveur Render. Antsipiriany: ' +
          error.message;
      } finally {
        question.disabled = false;
        send.disabled = false;
        question.focus();
        chat.scrollTop = chat.scrollHeight;
      }
    });
  </script>
</body>
</html>
